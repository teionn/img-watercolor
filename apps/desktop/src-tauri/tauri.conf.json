{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "img-watercolor",
  "version": "0.1.0",
  "identifier": "com.imgwatercolor.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "img-watercolor — 絵画調レンダリング",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
